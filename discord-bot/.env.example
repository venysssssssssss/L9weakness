DISCORD_TOKEN=seu_token_aqui
CLIENT_ID=seu_client_id_aqui
# NVIDIA BUILD — https://build.nvidia.com (Generate API Key)
NVIDIA_API_KEY=sua_nvidia_api_key_aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=openai/gpt-oss-20b
# Cadeias de fallback (csv, ordem = prioridade). Chat = qualidade; Fast = resumos/aprendizado.
NVIDIA_CHAT_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b,z-ai/glm-5.3,openai/gpt-oss-20b
NVIDIA_FAST_MODELS=nvidia/nemotron-3-super-120b-a12b,mistralai/mistral-nemotron,nvidia/nemotron-3.5-lightning-30b-a3b,openai/gpt-oss-20b
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b,black-forest-labs/flux.1-dev
NVIDIA_IMAGE_SIZE=1024x1024
# Limites para proteger créditos (segundos / por dia por guild)
VISION_COOLDOWN_SEC=45
VISION_DAILY_LIMIT=20
IMAGE_COOLDOWN_SEC=15
IMAGE_DAILY_LIMIT=15
# Aprendizado contínuo — 6 slots/dia x 10 min (cron UTC). LEARNING_START_HOUR (legado) ainda funciona se LEARNING_CRON vazio.
LEARNING_ENABLED=true
LEARNING_CRON=0 */4 * * *
LEARNING_DURATION_MIN=10
LEARNING_MAX_PAGES_DAY=250
LEARNING_RUN_ON_STARTUP=false
# Opcional: Spotify API para playlists/albuns (obtenha em https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=seu_spotify_client_id
SPOTIFY_CLIENT_SECRET=seu_spotify_client_secret
# Datas comemorativas do dia (cron no fuso DAILY_DATES_TZ) no canal DAILY_DATES_CHANNEL (nome) ou DAILY_DATES_CHANNEL_ID
DAILY_DATES_CRON=0 22 * * *
DAILY_DATES_TZ=America/Sao_Paulo
DAILY_DATES_CHANNEL=general
